{
  "name": "nataiji",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node --import ./src/gmail-mail-bridge.js src/server.js",
    "check": "node --check src/server.js && node --check src/gmail-mail-bridge.js && node scripts/server-smoke.mjs",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:prepare:android": "npx cap add android && npx cap sync android",
    "mobile:prepare:ios": "npx cap add ios && npx cap sync ios",
    "mobile:doctor": "npx cap doctor",
    "mobile:assets:android": "capacitor-assets generate --android --iconBackgroundColor '#fbfaf6' --iconBackgroundColorDark '#082b4b' --splashBackgroundColor '#fbfaf6' --splashBackgroundColorDark '#082b4b'",
    "mobile:assets:ios": "capacitor-assets generate --ios --iconBackgroundColor '#fbfaf6' --iconBackgroundColorDark '#082b4b' --splashBackgroundColor '#fbfaf6' --splashBackgroundColorDark '#082b4b'",
    "release:audit": "node scripts/release-audit.mjs",
    "release:check": "npm run check && npm run release:audit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "express": "^5.1.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "redis": "^4.7.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.0",
    "@capacitor/assets": "^3.0.5"
  }
}
